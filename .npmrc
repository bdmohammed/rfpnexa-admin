# TEMPORARY: eslint-plugin-react and eslint-plugin-jsx-a11y haven't
# published ESLint 10 peer support yet (tracking: jsx-eslint/eslint-plugin-react#3977).
# Remove this once those plugins ship ESLint 10 peer ranges, or replace
# with targeted `overrides` in package.json instead.
# legacy-peer-deps=true

# Ensure consistent, reproducible installs across machines/CI
engine-strict=true
save-exact=false

# Faster installs, avoids redundant network calls for already-cached packages
prefer-offline=false
fund=false
audit=false

# Avoid peer dependency install prompts hanging in CI
audit-level=high
